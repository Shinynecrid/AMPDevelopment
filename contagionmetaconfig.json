[
    {
        "ConfigFile": "contagion/cfg/server.cfg",
        "ConfigType": "Text",
        "Nodes": [
            {
                "Tag": "hostname",
                "SettingName": "Hostname",
                "DisplayName": "Hostname",
                "Mapping": "hostname \"(?<value>.*)\"",
                "Setter": "hostname \"{{value}}\""
            },
            {
                "Tag": "sv_password",
                "SettingName": "ServerPassword",
                "DisplayName": "Server Password",
                "Mapping": "sv_password \"(?<value>.*)\"",
                "Setter": "sv_password \"{{value}}\""
            }
        ]
    }
]
