Meta.DisplayName=Aloft
Meta.Description=Aloft Dedicated Server
Meta.OS=Windows, Linux
Meta.Arch=x86_64
Meta.Author=Shinynecrid
Meta.URL=https://store.steampowered.com/app/1660080/Aloft/
Meta.DisplayImageSource=steam:1660080
Meta.EndpointURIFormat=
Meta.ConfigManifest=aloftconfig.json
Meta.MetaConfigManifest=aloftmetaconfig.json
Meta.ConfigRoot=aloft.kvp
Meta.MinAMPVersion=2.6.2.8
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=The server is Windows-only and runs on Linux via Proton GE, which requires Xvfb and glibc 2.38 or newer (Debian trixie). Using a container avoids the need for you to install these dependencies on the host.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=356988e2-b2a2-4e00-b53f-3884c3b58aa4
Meta.AppIsMultiIPAware=False
App.DisplayName=Aloft
App.RootDir=./aloft/
App.BaseDirectory=./aloft/1660080/
App.ExecutableWin=1660080\Aloft.exe
App.ExecutableLinux=/usr/bin/xvfb-run
App.WorkingDir=1660080
App.LinuxCommandLineArgs=-a "{{$FullRootDir}}.proton/proton" runinprefix "{{$FullBaseDir}}Aloft.exe"
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} -batchmode -nographics -server load#{{MapName}}# servername#{{ServerName}}# log#ERROR# isvisible#{{IsVisible}}# playercount#{{$MaxUsers}}# serverport#{{$GamePort}}# admin#{{AdminSteamID1}}# admin#{{AdminSteamID2}}# admin#{{AdminSteamID3}}# admin#{{AdminSteamID4}}#
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"LD_LIBRARY_PATH":"{{$FullRootDir}}linux64:%LD_LIBRARY_PATH%","SteamAppId":"1660080","STEAM_COMPAT_DATA_PATH":"{{$FullRootDir}}.proton/compatdata","STEAM_COMPAT_CLIENT_INSTALL_PATH":"{{$FullBaseDir}}.steam/steam","HOME":"{{$FullBaseDir}}","PROTON_USE_WINED3D":"1","WINEDEBUG":"-all"}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=SIGTERM
App.ExitMethodWindows=CtrlC
App.ExitString=stop
App.ExitTimeout=30
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[aloftports.json]
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=GamePort
App.UniversalSleepSteamQueryPortRef=QueryPort
App.MaxUsers=8
App.UseRandomAdminPassword=False
App.AdminMethod=STDIO
App.UpdateSources=@IncludeJson[aloftupdates.json]
App.PreStartStages=@IncludeJson[aloftstart.json]
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=True
App.RapidStartup=False
App.MonitorChildProcessName=^.*{{$WineBaseDir}}Aloft\.exe.*$
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^(?:Modifying the material count of a VFXRenderer is not allowed|It is not allowed to set the material of a VFXRenderer)\. This method has no effect\.$
Console.AppReadyRegex=^.*Server Ready : .*$
Console.UserJoinRegex=^Player joined: ID : (?!1\s)(?<sessionid>\d+)\s+Name : (?<username>.+?)\s*$
Console.UserLeaveRegex=^Player left: (?!Server\s*$)(?<username>.+?)\s*$
Console.UserChatRegex=^(?!#|\[|Player (?:joined|left)|Server Ready : )(?<username>[^\r\n]+?) : (?<message>.+?)\s*$
Console.UpdateAvailableRegex=
Console.ServerInfoRegex=^(?:#E: )?Server Ready : (?<Room_Code>\d+).*$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
