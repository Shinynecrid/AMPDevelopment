Meta.DisplayName=Redis Database
Meta.Description=In-memory data structure store used as a database, cache, and message broker.
Meta.OS=Windows, Linux
Meta.Arch=x86_64
Meta.Author=Shinynecrid
Meta.URL=https://redis.io/
Meta.DisplayImageSource=url:https://redis.io/images/redis-white.png
Meta.EndpointURIFormat=redis://{ip}:{{$ApplicationPort}}
Meta.ConfigManifest=redisconfig.json
Meta.MetaConfigManifest=redismetaconfig.json
Meta.ConfigRoot=redis.kvp
Meta.MinAMPVersion=2.6.0.4
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.ContainerPolicy=Supported
Meta.ConfigVersion=2
Meta.AppConfigId=c4d2e1b8-7a5e-4f12-9c3b-d5e6f7a8b9c0
Meta.AppIsMultiIPAware=True
App.DisplayName=Redis Database
App.RootDir=./redis/
App.BaseDirectory=./redis/
App.ExecutableWin=redis-server.exe
App.ExecutableLinux=redis-server
App.WorkingDir=
App.CommandLineArgs=redis.conf {{$FormattedArgs}}
App.CommandLineParameterFormat=--{0} {1}
App.CommandLineParameterDelimiter= 
App.ExitMethod=CtrlC
App.ExitMethodWindows=CtrlC
App.ExitTimeout=15
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.Ports=@IncludeJson[redisports.json]
App.PrimaryApplicationPortRef=ApplicationPort
App.AdminPortRef=ApplicationPort
App.UpdateSources=@IncludeJson[redisupdates.json]
App.ApplicationReadyMode=RegexMatch
Console.AppReadyRegex=^.*Ready to accept connections.*$
Limits.SleepMode=False
Limits.SleepOnStart=False
