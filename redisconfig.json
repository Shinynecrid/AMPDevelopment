[
    {
        "DisplayName": "Redis Password",
        "Category": "Redis:storage",
        "Subcategory": "Security:security:1",
        "FieldName": "requirepass",
        "InputType": "password",
        "DefaultValue": "",
        "Description": "Password required for client authentication (AUTH). Leave blank to disable password authentication."
    },
    {
        "DisplayName": "Protected Mode",
        "Category": "Redis:storage",
        "Subcategory": "Security:security:1",
        "FieldName": "protected_mode",
        "InputType": "enum",
        "EnumValues": {
            "no": "Disabled (Allows external/cross-container connections)",
            "yes": "Enabled (Local loopback connections only)"
        },
        "DefaultValue": "no",
        "Description": "When disabled, Redis permits external network connections from other servers in the cluster."
    },
    {
        "DisplayName": "Maximum Memory",
        "Category": "Redis:storage",
        "Subcategory": "Memory & Limits:memory:2",
        "FieldName": "maxmemory",
        "InputType": "text",
        "DefaultValue": "1gb",
        "Description": "Memory threshold for Redis (e.g. 512mb, 1gb, 2gb, or 0 for unlimited)."
    },
    {
        "DisplayName": "Eviction Policy",
        "Category": "Redis:storage",
        "Subcategory": "Memory & Limits:memory:2",
        "FieldName": "maxmemory_policy",
        "InputType": "enum",
        "EnumValues": {
            "noeviction": "No Eviction (Return errors on memory limit)",
            "allkeys-lru": "All Keys LRU (Evict least recently used)",
            "volatile-lru": "Volatile LRU (Evict keys with expire set)",
            "allkeys-random": "All Keys Random",
            "volatile-random": "Volatile Random",
            "volatile-ttl": "Volatile TTL (Evict shortest time-to-live)"
        },
        "DefaultValue": "noeviction",
        "Description": "Eviction behavior applied when maximum memory is reached."
    },
    {
        "DisplayName": "Append Only File (AOF)",
        "Category": "Redis:storage",
        "Subcategory": "Persistence:save:3",
        "FieldName": "appendonly",
        "InputType": "enum",
        "EnumValues": {
            "yes": "Enabled (High durability logging)",
            "no": "Disabled (RDB snapshots only)"
        },
        "DefaultValue": "yes",
        "Description": "Enables write log journaling for durable persistence."
    },
    {
        "DisplayName": "RDB Snapshot Schedule",
        "Category": "Redis:storage",
        "Subcategory": "Persistence:save:3",
        "FieldName": "save",
        "InputType": "text",
        "DefaultValue": "900 1 300 10 60 10000",
        "Description": "Snapshot schedule formatted as pairs of seconds and changes. Default saves at 900s/1 change, 300s/10 changes, 60s/10000 changes."
    },
    {
        "DisplayName": "Client Idle Timeout",
        "Category": "Redis:storage",
        "Subcategory": "Network Settings:settings_ethernet:4",
        "FieldName": "timeout",
        "InputType": "number",
        "DefaultValue": "0",
        "Description": "Closes client connection after N seconds of inactivity (0 to disable)."
    },
    {
        "DisplayName": "Redis Port",
        "Category": "Redis:storage",
        "Subcategory": "Network Settings:settings_ethernet:4",
        "FieldName": "$ApplicationPort",
        "InputType": "number",
        "DefaultValue": "6379",
        "Description": "TCP port Redis listens on."
    },
    {
        "DisplayName": "Bind Address",
        "Category": "Redis:storage",
        "Subcategory": "Network Settings:settings_ethernet:4",
        "FieldName": "$ApplicationIPBinding",
        "InputType": "text",
        "DefaultValue": "0.0.0.0",
        "Description": "Interface IP address to bind to. Use 0.0.0.0 to listen on all interfaces."
    }
]
