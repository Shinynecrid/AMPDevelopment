Meta.DisplayName=ATLAS [WIP]
Meta.Description=ATLAS Dedicated Server. WORK IN PROGRESS, NOT READY FOR USE: still being tested. Linux requires a container and runs the last Linux build (v557.6), which is older than the Windows build
Meta.OS=Windows, Linux
Meta.Arch=x86_64
Meta.Author=Shinynecrid
Meta.URL=https://www.playatlas.com/
Meta.DisplayImageSource=steam:834910
Meta.EndpointURIFormat=steam://connect/{ip}:{GenericModule.App.Ports.$QueryPort}
Meta.ConfigManifest=atlasconfig.json
Meta.MetaConfigManifest=atlasmetaconfig.json
Meta.ConfigRoot=atlas.kvp
Meta.MinAMPVersion=2.6.0.4
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.ExtraContainerPackages=["libgssapi3t64-heimdal"]
Meta.DockerRequired=False
Meta.ContainerPolicy=SupportedOnWindows, RequiredOnLinux
Meta.ConfigReleaseState=PreRelease
Meta.ConfigVersion=1
Meta.ReleaseNotes=Work in progress. Not for production use: still being tested.
Meta.AppConfigId=2b9914ae-8f4d-43af-8087-7ea9602d5d14
Meta.ContainerPolicyReason=The Linux server needs legacy libraries (OpenSSL 1.0, protobuf 10, libidn 11, OpenLDAP 2.4) that the container provides.
Meta.NoCommercialUsage=False
Meta.Prerequisites=[]
Meta.AppIsMultiIPAware=True
App.DisplayName=ATLAS
App.RootDir=./atlas/
App.BaseDirectory=./atlas/1006030/
App.ExecutableWin=1006030\ShooterGame\Binaries\Win64\ShooterGameServer.exe
App.ExecutableLinux=1006030/ShooterGame/Binaries/Linux/ShooterGameServer
App.WorkingDir=1006030{{Linux:/ShooterGame/Binaries/Linux}}
App.WindowsCommandLineArgs=-servergamelog
App.LinuxCommandLineArgs=
App.CommandLineArgs=Ocean?ServerX={{ServerX}}?ServerY={{ServerY}}?Port={{$GamePort}}?QueryPort={{$QueryPort}}?MaxPlayers={{$MaxUsers}}?RCONPort={{$RCONPort}}?RCONEnabled=True?RCONServerGameLogBuffer=600?ServerAdminPassword={{$RemoteAdminPassword}}{{CustomOptions}} -log -server -useallavailablecores {{BattlEye}}{{EnableIdlePlayerKick}}{{ForceAllowCaveFlyers}}{{passivemods}}{{mods}}{{$PlatformArgs}} {{$FormattedArgs}} {{CustomFlags}}
App.ExitMethod=String
App.ExitString=DoExit
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.TailLogFilePath={{$FullBaseDir}}ShooterGame/Saved/Logs/ShooterGame.log
App.Ports=@IncludeJson[atlasports.json]
App.AdminPortRef=RCONPort
App.PrimaryApplicationPortRef=GamePort
App.UseRandomAdminPassword=True
App.PersistRandomPassword=True
App.RemoteAdminPassword=
App.AdminMethod=SourceRCON
App.AdminLoginTransform=None
App.RCONConnectDelaySeconds=15
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0.09
App.RCONHeartbeatCommand=GetGameLog
App.RCONSelectIPMethod=Loopback
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter= 
App.UpdateSources=@IncludeJson[atlasupdates.json]
App.ApplicationIPBinding=0.0.0.0
App.MaxUsers=10
App.RapidStartup=False
App.ExitFile=app_exit.lck
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.Compatibility=None
App.AppSettings={}
App.UseLinuxIOREDIR=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.UniversalSleepApplicationUDPPortRef=GamePort
App.UniversalSleepSteamQueryPortRef=QueryPort
App.SteamForceLoginPrompt=False
App.MonitorChildProcessName=
App.TelnetLoginFormat={0}
App.SteamUpdateAnonymousLogin=True
App.EnvironmentVariables={"SteamAppId":"834910","LD_LIBRARY_PATH":"{{$FullRootDir}}legacylibs"}
App.ApplicationReadyMode=RCONConnected
Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^(Keep Alive|\[S_API FAIL\] SteamAPI_Init\(\) failed; SteamAPI_IsSteamRunning\(\) failed\.|Server received, But no response!! \n |Setting breakpad minidump AppID = 834910)$
Console.AppReadyRegex=^$
Console.UserJoinRegex=^.*Join succeeded: (?<username>.+)$
Console.UserLeaveRegex=^.*Unloading Player: (?<username>.+)$
Console.UserChatRegex=^$
Console.UserActions={}
Console.UpdateAvailableRegex=^$
Console.SuppressLogAtStart=False
Console.MetricsRegex=
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
