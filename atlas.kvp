Meta.DisplayName=ATLAS
Meta.Description=A massively multiplayer first-and-third-person fantasy pirate adventure.
Meta.OS=Windows, Linux
Meta.Arch=x86_64
Meta.Author=Systems Expert
Meta.URL=https://www.playatlas.com/
Meta.DisplayImageSource=steam:834910
Meta.EndpointURIFormat=steam://connect/{ip}:{GenericModule.App.Ports.$QueryPort}
Meta.ConfigManifest=atlasconfig.json
Meta.MetaConfigManifest=atlasmetaconfig.json
Meta.ConfigRoot=atlas.kvp
Meta.MinAMPVersion=2.6.0.4
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.ContainerPolicy=Supported
Meta.ConfigVersion=5
Meta.AppConfigId=f8c5b9e0-0c4d-4a7b-9e8c-a1d2e3f4a5b6
Meta.AppIsMultiIPAware=True
App.DisplayName=ATLAS
App.RootDir=./atlas/
App.BaseDirectory=./atlas/1006030/
App.ExecutableWin=1006030\ShooterGame\Binaries\Win64\ShooterGameServer.exe
App.ExecutableLinux=1006030/ShooterGame/Binaries/Linux/ShooterGameServer
App.WorkingDir=1006030
App.WindowsCommandLineArgs=-servergamelog
App.LinuxCommandLineArgs=
App.CommandLineArgs=Ocean?ServerX={{ServerX}}?ServerY={{ServerY}}?Port={{$GamePort}}?QueryPort={{$QueryPort}}?RCONPort={{$RCONPort}}?RCONEnabled=True?RCONServerGameLogBuffer=600?ServerAdminPassword={{$RemoteAdminPassword}}?SessionName="{{ServerName}}"{{CustomOptions}} -log -server -useallavailablecores {{BattlEye}}{{EnableIdlePlayerKick}}{{ForceAllowCaveFlyers}}{{passivemods}}{{mods}}{{$PlatformArgs}} {{$FormattedArgs}} {{CustomFlags}}
App.ExitMethod=String
App.ExitTimeout=120
App.ExitString=DoExit
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.TailLogFilePath={{$FullBaseDir}}ShooterGame/Saved/Logs/ShooterGame.log
App.Ports=@IncludeJson[atlasports.json]
App.AdminPortRef=RCONPort
App.PrimaryApplicationPortRef=GamePort
App.UseRandomAdminPassword=True
App.PersistRandomPassword=True
App.RemoteAdminPassword=
App.AdminMethod=SourceRCON
App.AdminLoginTransform=None
App.RCONConnectDelaySeconds=15
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0.09
App.RCONHeartbeatCommand=GetGameLog
App.RCONSelectIPMethod=Loopback
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter= 
App.UpdateSources=@IncludeJson[atlasupdates.json]
App.SteamAppId=1006030
App.SteamUpdateAnonymousLogin=True
App.EnvironmentVariables={"SteamAppId":"834910"}
App.ApplicationReadyMode=RCONConnected
Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^(Keep Alive|\[S_API FAIL\] SteamAPI_Init\(\) failed; SteamAPI_IsSteamRunning\(\) failed\.|Server received, But no response!! \n |Setting breakpad minidump AppID = 834910)$
Console.AppReadyRegex=^$
Console.UserJoinRegex=^.*Join succeeded: (?<username>.+)$
Console.UserLeaveRegex=^.*Unloading Player: (?<username>.+)$
Limits.SleepMode=True
Limits.SleepOnStart=False
