[GenericModule.Meta]
GenericModule.Meta.AppConfigId=contagion
GenericModule.Meta.DisplayName=Contagion
GenericModule.Meta.Description=Contagion Dedicated Server (Wine)
GenericModule.Meta.DisplayImageSource=https://cdn.cloudflare.steamstatic.com/steam/apps/238430/header.jpg
GenericModule.Meta.OS=Windows

[GenericModule.App]
ApplicationName=Contagion
Executable=srcds.exe
AppId=293030
SteamAppPlatform=windows

# Process Management
ConsoleMode=StdInOut
ReadyText=Connection to Steam servers successful
StopCommand=quit
StopMethod=SendString
KillTimeout=30

# Launch Arguments
Arguments=-game contagion -console -usercon +ip 0.0.0.0 -port {{$ApplicationPort1}} +maxplayers {{MaxPlayers}} +map {{MapName}}

# Containerization
ContainerPolicy=wine-stable
