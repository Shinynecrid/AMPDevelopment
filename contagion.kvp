Meta.DisplayName=Contagion
Meta.Description=Fast-paced cooperative and competitive zombie survival horror based on the Source Engine.
Meta.OS=Windows, Linux
Meta.Arch=x86_64
Meta.Author=Systems Expert
Meta.URL=https://www.contagion-game.com/
Meta.DisplayImageSource=steam:238430
Meta.EndpointURIFormat=steam://connect/{ip}:{{$ServerPort}}
Meta.ConfigManifest=contagionconfig.json
Meta.MetaConfigManifest=contagionmetaconfig.json
Meta.ConfigRoot=contagion.kvp
Meta.MinAMPVersion=2.6.0.4
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.ContainerPolicy=Supported
Meta.ConfigVersion=10
Meta.AppConfigId=b1e29303-0c4f-4d32-9a3c-b2659e782d30
Meta.AppIsMultiIPAware=True
App.DisplayName=Contagion
App.RootDir=./contagion/
App.BaseDirectory=./contagion/293030/
App.ExecutableWin=srcds.exe
App.WorkingDir=293030
App.WindowsCommandLineArgs=
App.CommandLineArgs=-game contagion -console -usercon -port {{$ServerPort}} -ip {{$ApplicationIPBinding}} -maxplayers {{$MaxUsers}} +rcon_password {{$RemoteAdminPassword}} +map {{map}} +exec server.cfg {{$FormattedArgs}}
App.ExitMethod=String
App.ExitTimeout=30
App.ExitString=quit
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.Ports=@IncludeJson[contagionports.json]
App.AdminPortRef=ServerPort
App.PrimaryApplicationPortRef=ServerPort
App.AdminMethod=SourceRCON
App.RCONConnectDelaySeconds=15
App.RCONConnectRetrySeconds=5
App.CommandLineParameterFormat=+{0} {1}
App.CommandLineParameterDelimiter= 
App.UpdateSources=@IncludeJson[contagionupdates.json]
App.SteamAppId=293030
App.SteamUpdateAnonymousLogin=True
App.EnvironmentVariables={"LD_LIBRARY_PATH":".:bin:%LD_LIBRARY_PATH%","SteamAppId":"238430", "@Platform": "windows", "WINEDEBUG":"-all"}
App.ApplicationReadyMode=RCONConnected
Console.AppReadyRegex=^Connection to Steam servers successful\.$
Console.UserJoinRegex=^"(?<username>.+?)<\d+><(?<userid>STEAM_[\d:]+?)><.*>" entered the game$
Console.UserLeaveRegex=^Dropped (?<username>.+?) from server
Limits.SleepMode=True
Limits.SleepOnStart=False
