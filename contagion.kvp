Meta.DisplayName=Contagion
Meta.Description=Fast-paced cooperative and competitive zombie survival horror based on the Source Engine.
Meta.OS=Windows, Linux
Meta.Arch=x86_64
Meta.Author=Shinynecrid
Meta.URL=https://www.contagion-game.com/
Meta.DisplayImageSource=steam:238430
Meta.EndpointURIFormat=steam://connect/{0}
Meta.ConfigManifest=contagionconfig.json
Meta.MetaConfigManifest=contagionmetaconfig.json
Meta.ConfigRoot=contagion.kvp
Meta.MinAMPVersion=2.6.0.4
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=The server requires Wine (ideally latest stable from winehq.org) to run on Linux. Using a container avoids the need for you to install these dependencies on the host.
Meta.ConfigVersion=15
Meta.AppConfigId=b1e29303-0c4f-4d32-9a3c-b2659e782d30
Meta.AppIsMultiIPAware=True
App.DisplayName=Contagion
App.RootDir=./contagion/
App.BaseDirectory=./contagion/293030/
App.ExecutableWin=293030\contagionds.exe
App.ExecutableLinux=/usr/bin/wine
App.WorkingDir=293030
App.LinuxCommandLineArgs=./contagionds.exe -game contagion -console -usercon -port {{$ServerPort}} -ip {{$ApplicationIPBinding}} -maxplayers {{$MaxUsers}} +rcon_password "{{$RemoteAdminPassword}}" +map {{map}} +exec server.cfg {{$FormattedArgs}}
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} -game contagion -console -usercon -port {{$ServerPort}} -ip {{$ApplicationIPBinding}} -maxplayers {{$MaxUsers}} +rcon_password "{{$RemoteAdminPassword}}" +map {{map}} +exec server.cfg {{$FormattedArgs}}
App.ExitMethod=String
App.ExitTimeout=30
App.ExitString=quit
App.MonitorChildProcessName=^.*contagionds\.exe.*-port {{$ServerPort}}.*$
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.Ports=@IncludeJson[contagionports.json]
App.AdminPortRef=ServerPort
App.PrimaryApplicationPortRef=ServerPort
App.UniversalSleepApplicationUDPPortRef=ServerPort
App.AdminMethod=SourceRCON
App.UseRandomAdminPassword=True
App.PersistRandomPassword=True
App.RemoteAdminPassword=
App.RCONConnectDelaySeconds=20
App.RCONConnectRetrySeconds=5
App.CommandLineParameterFormat=+{0} {1}
App.CommandLineParameterDelimiter= 
App.UpdateSources=@IncludeJson[contagionupdates.json]
App.SteamAppId=293030
App.SteamUpdateAnonymousLogin=True
App.EnvironmentVariables={"SteamAppId":"238430","WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all"}
App.ApplicationReadyMode=Console
Console.AppReadyRegex=^\[Steam API\] Initalized Steam Game Server
Console.UserJoinRegex=^"(?<username>.+?)<\d+><(?<userid>STEAM_[\d:]+?)><.*>" entered the game$
Console.UserLeaveRegex=^Dropped (?<username>.+?) from server
Limits.SleepMode=True
Limits.SleepOnStart=False
