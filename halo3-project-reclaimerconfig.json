    {
        "DisplayName": "RCON Address",
        "Category": "Halo 3:stadia_controller",
        "Subcategory": "Security:security:3",
        "Description": "Which networks can connect to the remote console (RCON). 127.0.0.1 accepts tools on this machine only. 0.0.0.0 accepts them from every network and the connection is not encrypted, so only allow your own tools through the firewall. AMP itself always connects from this machine",
        "Keywords": "rcon,remote,console,address,bind,network,0.0.0.0,localhost",
        "FieldName": "RconAddress",
        "InputType": "enum",
        "DefaultValue": "127.0.0.1",
        "EnumValues": {
            "127.0.0.1": "127.0.0.1 (this machine only, default)",
            "0.0.0.0": "0.0.0.0 (every network, not encrypted)"
        }
    },
